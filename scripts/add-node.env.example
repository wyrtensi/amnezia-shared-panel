# Deployment-specific settings for scripts/add-node.sh.
#
# Copy to scripts/add-node.env (git-ignored) and fill in for YOUR deployment.
# This file holds addresses, paths, and defaults only — never key material.
# The node-agent API key is generated on the node and never leaves it except
# on the panel host's own SSH hop during registration.

# --- Panel (control plane) host ---------------------------------------------
# SSH target of the host running infra/prod (the panel + worker).
PANEL_SSH=root@panel.example.com
# Directory holding the prod compose project on that host.
PANEL_COMPOSE_DIR=/opt/amnezia-panel/infra/prod
# Compose service to run the bundled admin CLI in. It authenticates by minting
# an x-panel-identity token from its own PANEL_IDENTITY_SECRET, so no
# Cloudflare service token is needed for a co-located rollout.
PANEL_CONTROL_API_SERVICE=control-api
PANEL_CONTROL_API_URL=http://127.0.0.1:3001
# The panel host's dedicated SSH key for reaching nodes (panel -> node).
# Created once with:
#   ssh-keygen -t ed25519 -f /root/.ssh/panel_nodes_key -N '' -C panel-to-nodes
PANEL_NODE_KEY=/root/.ssh/panel_nodes_key

# --- node-agent image -------------------------------------------------------
# Where the pinned node-agent image comes from. The image is built once and
# shipped to each node; nodes never build it (compose sets pull_policy: never).
#   panel — copy it from an existing node deployment on the panel host (default)
#   local — build it here from services/node-agent, then ship it
NODE_AGENT_IMAGE_SOURCE=panel
# Only used when NODE_AGENT_IMAGE_SOURCE=panel: a node deployment on the panel
# host whose .env names the image to copy.
PANEL_NODE_DIR=/opt/amnezia-panel-node

# --- Tunnels (panel -> node) ------------------------------------------------
# The node-agent is loopback-only, so the worker reaches it through a
# supervised SSH tunnel. Bind the local end on the Docker bridge gateway (a
# private address the dockerized worker resolves as host.docker.internal),
# never on a public interface.
TUNNEL_BIND=172.17.0.1
# First local port to allocate. Each node gets the next free one.
TUNNEL_PORT_BASE=4105

# --- Node defaults (override per run with flags) ----------------------------
NODE_SSH_USER=root
NODE_DIR=/opt/amnezia-panel-node
# Capacity for the node, 1..500. Leave it unset (or comment it out) and the
# script derives it from the node's available memory using the same formula the
# preflight RAM gate applies, so a small host is registered for the capacity it
# can actually carry instead of the template maximum.
# NODE_MAX_PEERS=500
NODE_WEIGHT=100
# Fallback protocol recorded on the node record. The authoritative set is
# supportedProtocols, which the worker syncs from the node's GET /server.
NODE_PROTOCOL=awg3
# Protocols offered to the key wizard. A brand-new node has no legacy peers,
# so awg3 alone is the right default; add awg2 only to carry existing peers.
NODE_ENABLED_PROTOCOLS=awg3
