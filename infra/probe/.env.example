# Copy to .env next to compose.yaml.

# Immutable image reference: an image ID (sha256:...) after `docker load`, or
# ghcr.io/<owner>/<repo>/reachability-probe@sha256:... from the release run.
PROBE_IMAGE=

# Loopback port the API is published on; the panel's SSH tunnel forwards to it.
PROBE_PORT=4002

# Memory ceiling and the V8 heap inside it. Raise both together.
PROBE_MEM_LIMIT=256m
PROBE_MAX_OLD_SPACE_MB=128
