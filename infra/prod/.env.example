# Production env for infra/prod/compose.yaml. Copy to .env and fill in.

# --- Database (never published to the host) ---
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://amnezia_panel:change-me-long-random@postgres:5432/amnezia_panel

# --- Config encryption keyring (generate: openssl rand -base64 32) ---
CONFIG_ENCRYPTION_KEYS_JSON={"1":"base64-encoded-32-byte-key"}
CONFIG_ENCRYPTION_ACTIVE_VERSION=1

# --- Cloudflare Access (required in production) ---
# From the Access application you create (see docs/CLOUDFLARE-SETUP.md).
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=your-access-application-aud
# First login by these emails becomes admin (comma-separated, lower-cased).
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# --- Direct login: server-side Google (for users who can't reach Cloudflare) ---
# Optional. Enables the panel's OWN Google login + session, in addition to
# Cloudflare Access, so the panel works on a DNS-only domain that bypasses the CF
# proxy (see infra/prod/Caddyfile.example and docs/INSTALL.md §3.5). CF Access
# still works where reachable.
#
# Shared secret between web and control-api (openssl rand -base64 32):
# PANEL_IDENTITY_SECRET=change-me-long-random
# Google OAuth 2.0 Web-application client from a project in your Workspace org.
# Authorized redirect URI: https://<direct host>/api/auth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# The panel's DIRECT public URL (the DNS-only host Caddy serves):
# PANEL_PUBLIC_URL=https://direct.example.com
# Email domains allowed to self-provision via the direct Google login (comma-sep);
# anyone else must be pre-created by an admin. The Cloudflare path is unaffected.
# AUTH_ALLOWED_DOMAINS=yourcompany.com

# --- Cloudflare Access two-way user sync (optional) ---
# When true, the worker keeps the panel's active users and the Access policy's
# allowed-email list in sync BOTH ways: add/remove in the panel updates the CF
# policy, and removing someone in the CF policy disables them in the panel.
# Requires the CF account/app/policy ids + API token, stored (encrypted) via the
# Administration → policy dialog. See docs/CLOUDFLARE-ACCESS.md.
ACCESS_SYNC_ENABLED=true
# How often to reconcile (ms). Default 1h.
# ACCESS_RECONCILE_INTERVAL_MS=3600000

# --- In-panel "Update" button (optional) ---
# Host path shared with control-api as the update spool. Install the host worker
# once with: sudo bash infra/prod/install-updater.sh
# UPDATE_SPOOL_HOST_DIR=/var/lib/amnezia-panel/update

# --- Host ports (loopback only; the Cloudflare Tunnel targets WEB_PUBLISH_PORT) ---
# Uncommon defaults so they do not clash with other services on a shared box.
WEB_PUBLISH_PORT=5430
CONTROL_API_PUBLISH_PORT=5431

# --- Image (optional) ---
# Defaults to the locally-built amnezia-panel/app:dev. Set to a GHCR tag later.
# PANEL_IMAGE=ghcr.io/wyrtensi/amnezia-shared-panel:latest
