# Production env for infra/prod/compose.yaml. Copy to .env and fill in.

# --- Database (never published to the host) ---
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://amnezia_panel:change-me-long-random@postgres:5432/amnezia_panel

# --- Config encryption keyring (generate: openssl rand -base64 32) ---
CONFIG_ENCRYPTION_KEYS_JSON={"1":"base64-encoded-32-byte-key"}
CONFIG_ENCRYPTION_ACTIVE_VERSION=1

# --- Cloudflare Access (required in production) ---
# From the Access application you create (see docs/CLOUDFLARE-SETUP.md).
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=your-access-application-aud
# First login by these emails becomes admin (comma-separated, lower-cased).
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# --- Host ports (loopback only; the Cloudflare Tunnel targets WEB_PUBLISH_PORT) ---
# Uncommon defaults so they do not clash with other services on a shared box.
WEB_PUBLISH_PORT=5430
CONTROL_API_PUBLISH_PORT=5431

# --- Image (optional) ---
# Defaults to the locally-built amnezia-panel/app:dev. Set to a GHCR tag later.
# PANEL_IMAGE=ghcr.io/wyrtensi/amnezia-shared-panel:latest
