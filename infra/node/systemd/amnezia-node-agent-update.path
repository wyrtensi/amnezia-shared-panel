[Unit]
Description=Watch for node-agent update requests from the panel

[Path]
# Level-triggered: fires the service whenever the request file exists. The
# updater deletes it when done, so the unit re-arms for the next request - and a
# request that arrives while an update is running is retried instead of lost.
PathExists=/var/lib/amnezia-node/update/request.json
Unit=amnezia-node-agent-update.service

[Install]
WantedBy=multi-user.target
