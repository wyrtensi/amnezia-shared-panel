# Preferred: the digest published by the node-agent release workflow, e.g.
#   ghcr.io/<owner>/<repo>/node-agent@sha256:<64 hex>
# deploy.sh pulls that form before preflight checks the image is present.
# Otherwise build services/node-agent on a host with headroom, load the image
# here, and set the immutable image ID that `docker load` reported ON THIS HOST.
NODE_AGENT_IMAGE=sha256:replace-with-64-hex-image-id

# Use: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
DOCKER_API_VERSION=1.44

# The address written into every generated client config (the Endpoint line
# and the vpn:// hostName). Use the node's public IPv4 address. A DNS name is
# accepted, but the client must resolve it on its own network before the tunnel
# exists and the panel cannot see when that fails - see docs/NODE-CONNECT.md,
# "Use the IP address, not a DNS name". 203.0.113.10 is a placeholder that
# preflight rejects.
SERVER_PUBLIC_HOST=203.0.113.10
SERVER_ID=00000000-0000-4000-8000-000000000000
SERVER_NAME=Amnezia node
SERVER_REGION=region-1
SERVER_WEIGHT=100
# Peers this node will accept, across all protocols. 500 is the validated
# maximum; the panel's automatic growth never exceeds this number. Change it
# with scripts/set-capacity.sh, which checks the RAM gate for the new number
# first and recreates only the node-agent, so no tunnel drops.
SERVER_MAX_PEERS=500

# --- node-agent memory (optional) ---
# Measured on two live nodes: the agent sits at 79-83 MiB RSS, while V8 had
# chosen a 1006 MiB old-space ceiling for itself on a 2 GiB host (it sizes the
# heap from HOST memory, which is shared with the data plane). These two bound
# it. Raise them together: a container ceiling without the engine setting is a
# delayed OOM kill rather than a limit. The gap between them covers the ~40 MiB
# of non-heap this process needs.
# NODE_AGENT_MEM_LIMIT=320m
# NODE_AGENT_MAX_OLD_SPACE_MB=192
