# Single toggle for the temporary containerd-shim-runc-v2 ttrpc#241 override.
#
# Set SHIM_OVERRIDE_MODE=upstream to disable the custom shim build and make
# agent-update.sh automatically remove the host amnezia-node-shim dpkg-divert
# override and restore the stock upstream binary on the next node-agent update.
SHIM_OVERRIDE_MODE=override
SHIM_TTRPC_REPO=https://github.com/wyrtensi/ttrpc.git
SHIM_TTRPC_REF=v1.2.10-amnezia.1
SHIM_TTRPC_COMMIT=3645259866b6106bf4a9f7112a7055047a816ae8
