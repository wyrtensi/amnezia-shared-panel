DATABASE_URL=postgres://amnezia_panel:change-me@127.0.0.1:5432/amnezia_panel
CONFIG_ENCRYPTION_KEYS_JSON={"1":"base64-encoded-32-byte-key"}
CONFIG_ENCRYPTION_ACTIVE_VERSION=1
# Multi-source live feeds (Re:filter, itdoginfo, ipdeny) for the ru_blacklist
# profile. LEAVE EMPTY to use the built-in defaults, fetched out of the box so a
# fresh install has a compact E-Core route profile (~1,250 routes) with no
# configuration.
# Set this only to point at different sources; RULE_FEEDS=[] disables feeds entirely.
# JSON array of {profile, sources:[{url, format, exclude?, maxIpv4PrefixLength?}]},
# format ∈ json|cidr-lines|domain-lines.
# A source with "exclude":true is SUBTRACTED: its CIDRs are taken out of what the
# other sources supply (the defaults use it to keep Russian address space direct).
# Optional maxIpv4PrefixLength (0..32) drops narrow IPv4 tail prefixes from a
# source (e.g. 24 skips scattered /25-/32 entries in Re:filter ipsum.lst).
RULE_FEEDS=
# Optional comma- or whitespace-separated http(s) cidr-lines URLs layered ON TOP
# of the resolved feeds (including built-in defaults) on every daily refresh
# without resetting RULE_COMPACTION_MODE or dropping RULE_EXTRAS:
#   RULE_EXTRA_INCLUDE_URLS — forced inclusions (protected from RU expansion and
#                             allowed to punch back into built-in direct shields,
#                             e.g. a daily Steam CM /32 list inside AS32590).
#   RULE_EXTRA_EXCLUDE_URLS — exact direct shields (subtracted verbatim, never
#                             expanded into enclosing /8 blocks).
RULE_EXTRA_INCLUDE_URLS=
RULE_EXTRA_EXCLUDE_URLS=
# Compaction mode for ru_blacklist:
#   compact_world (default for built-in feeds, E-Core) — compact inverted RU
#                 (0.0.0.0/0 \ expanded RU, ~1,250 routes, ~85% of non-RU IPv4
#                 through VPN including Akamai/Fastly Steam Store, 0% RU/LAN/
#                 Apple/Valve AS32590 SteamCache).
#   blocked_only  — RU-safe & LAN-safe supernetting capped by RULE_COLLATERAL_CAP
#                 (~780 routes total, minimal VPS bandwidth, Apple/Steam/MS direct).
#   lossless      (default for custom RULE_FEEDS) — exact subtraction only.
RULE_COMPACTION_MODE=
# Max extra non-RU public IPv4 share (0..0.25) allowed in blocked_only mode.
RULE_COLLATERAL_CAP=0.005
# Keep Apple (17.0.0.0/8) and Valve AS32590 primary SteamCache download servers
# out of compacted supernets so OS updates and Steam game downloads stay direct.
RULE_DIRECT_APPLE=true
RULE_DIRECT_STEAM_CACHE=true
# Route-rule feeds activate by default. Set to "false" to keep the profile's
# auto-fetched versions quarantined until an operator reviews them.
RU_BLACKLIST_POC_APPROVED=true
TELEMETRY_RAW_RETENTION_DAYS=7
TELEMETRY_HOURLY_RETENTION_DAYS=90
TELEMETRY_DAILY_RETENTION_DAYS=730
# --- Background periods: DEFAULTS ONLY -----------------------------------
# Every period below is now editable in the panel (Administration -> policy ->
# Background periods) and from the CLI (`periods`, `policy-set --<period>=`).
# A value set there wins; the variables here are what applies when it is unset,
# which is why an existing deployment keeps exactly the periods it had.
# The panel holds its own values to sane floors (a 30 s poll, for instance);
# these variables are NOT re-bounded, so a host that has always run a faster
# period keeps booting.
# The periods with no variable at all -- peer sampling, maintenance, the
# node-agent release check, the route-feed download -- are panel-only.
#
# How often the worker polls every node (seconds). Each poll is four HTTP
# requests per node, and at most four nodes are polled at a time.
TELEMETRY_POLL_SEC=60
# How often a poll keeps a host-metrics HISTORY row (node_metrics_samples).
# One row per node per period: 7 days at 300 s is ~2,016 rows ~360 KB per node;
# at 60 s it is ~10,080 rows ~1.8 MB per node. Must be >= TELEMETRY_POLL_SEC,
# because only a poll can write a row.
NODE_METRICS_SAMPLE_SEC=300
# How long those history rows are kept. Nothing else prunes that table.
NODE_METRICS_RETENTION_DAYS=7
# Cloudflare Access deactivation sync (off by default). When enabled, the worker
# periodically disables + revokes any active non-admin user whose email is no
# longer allowed. An empty allowlist is treated as a lookup failure (no-op).
# See docs/CLOUDFLARE-ACCESS.md.
ACCESS_RECONCILE_ENABLED=false
# Source of allowed emails: "allowlist" (ACCESS_ALLOWLIST) or "cloudflare".
ACCESS_DIRECTORY=allowlist
ACCESS_ALLOWLIST=
# Default only, like the periods above: the panel's `accessReconcileSec`
# setting wins when it is set. Still expressed in MILLISECONDS here.
ACCESS_RECONCILE_INTERVAL_MS=3600000
# Only for ACCESS_DIRECTORY=cloudflare (adapter is an extension point):
CF_ACCESS_ACCOUNT_ID=
CF_API_TOKEN=
CF_ACCESS_GROUP_ID=
# Panel -> Access write-back: push active-user emails into the Access policy's
# include list. Off by default; uses the API token + account/app/policy IDs set
# in admin settings (portal_policy). No-op with no active users. See
# docs/CLOUDFLARE-ACCESS.md.
ACCESS_WRITEBACK_ENABLED=false
