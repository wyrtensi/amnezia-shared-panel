DATABASE_URL=postgres://amnezia_panel:change-me@127.0.0.1:5432/amnezia_panel
CONFIG_ENCRYPTION_KEYS_JSON={"1":"base64-encoded-32-byte-key"}
CONFIG_ENCRYPTION_ACTIVE_VERSION=1
# Legacy single-feed URL for the ru_whitelist profile (JSON {cidrs,domains}).
ROSCOMVPN_RULES_URL=
# Multi-profile, multi-source live feeds (RoscomVPN / Re:filter). LEAVE EMPTY to
# use the built-in defaults: both profiles below are fetched out of the box, so a
# fresh install has working route profiles with no configuration. Set this only
# to point at different sources; RULE_FEEDS=[] disables feeds entirely.
# JSON array of {profile, sources:[{url, format}]}, format ∈ json|cidr-lines|domain-lines.
# domain-lines entries must be bare ASCII/punycode hostnames (e.g. xn--p1ai for
# .рф) — raw Unicode, wildcards (*.), and leading dots are dropped as invalid,
# and a feed that is >15% invalid is quarantined whole. cidr-lines are IPv4/IPv6
# CIDRs. Verified sources (tens of thousands of entries; refreshed every 6h):
#   ru_blacklist (only blocked → VPN):
#     https://github.com/1andrevich/Re-filter-lists/releases/latest/download/ipsum.lst        cidr-lines
#     https://github.com/1andrevich/Re-filter-lists/releases/latest/download/domains_all.lst  domain-lines
#   ru_whitelist (foreign → VPN):
#     https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geoip/release/text/whitelist.txt      cidr-lines
# Example (blacklist CIDRs+domains):
# RULE_FEEDS=[{"profile":"ru_blacklist","sources":[{"url":"https://github.com/1andrevich/Re-filter-lists/releases/latest/download/ipsum.lst","format":"cidr-lines"},{"url":"https://github.com/1andrevich/Re-filter-lists/releases/latest/download/domains_all.lst","format":"domain-lines"}]}]
RULE_FEEDS=
# Route-rule feeds activate by default. Set a profile to "false" to keep its
# auto-fetched versions quarantined until an operator reviews them.
RU_WHITELIST_POC_APPROVED=true
RU_BLACKLIST_POC_APPROVED=true
TELEMETRY_RAW_RETENTION_DAYS=7
TELEMETRY_HOURLY_RETENTION_DAYS=90
TELEMETRY_DAILY_RETENTION_DAYS=730
# How often the worker polls every node (seconds). Each poll is four HTTP
# requests per node, and at most four nodes are polled at a time.
TELEMETRY_POLL_SEC=60
# How often a poll keeps a host-metrics HISTORY row (node_metrics_samples).
# One row per node per period: 7 days at 300 s is ~2,016 rows ~360 KB per node;
# at 60 s it is ~10,080 rows ~1.8 MB per node. Must be >= TELEMETRY_POLL_SEC,
# because only a poll can write a row.
NODE_METRICS_SAMPLE_SEC=300
# How long those history rows are kept. Nothing else prunes that table.
NODE_METRICS_RETENTION_DAYS=7
# Cloudflare Access deactivation sync (off by default). When enabled, the worker
# periodically disables + revokes any active non-admin user whose email is no
# longer allowed. An empty allowlist is treated as a lookup failure (no-op).
# See docs/CLOUDFLARE-ACCESS.md.
ACCESS_RECONCILE_ENABLED=false
# Source of allowed emails: "allowlist" (ACCESS_ALLOWLIST) or "cloudflare".
ACCESS_DIRECTORY=allowlist
ACCESS_ALLOWLIST=
ACCESS_RECONCILE_INTERVAL_MS=3600000
# Only for ACCESS_DIRECTORY=cloudflare (adapter is an extension point):
CF_ACCESS_ACCOUNT_ID=
CF_API_TOKEN=
CF_ACCESS_GROUP_ID=
# Panel -> Access write-back: push active-user emails into the Access policy's
# include list. Off by default; uses the API token + account/app/policy IDs set
# in admin settings (portal_policy). No-op with no active users. See
# docs/CLOUDFLARE-ACCESS.md.
ACCESS_WRITEBACK_ENABLED=false
