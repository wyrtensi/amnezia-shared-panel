NODE_ENV=development
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=3001
# Enables the x-dev-user-email header (any caller is trusted as that user).
# Development only, and only on a loopback bind. Never set this in production.
ALLOW_DEV_IDENTITY=true
DATABASE_URL=postgres://amnezia_panel:change-me@127.0.0.1:5432/amnezia_panel
CONFIG_ENCRYPTION_KEYS_JSON={"1":"base64-encoded-32-byte-key"}
CONFIG_ENCRYPTION_ACTIVE_VERSION=1
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=your-access-application-aud
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
