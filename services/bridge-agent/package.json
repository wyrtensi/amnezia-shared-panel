{
  "name": "bridge-agent",
  "version": "0.1.0",
  "description": "Versioned, authenticated status and identity API for an AWG node bridge, read from the local frps dashboard API",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
